{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreativeBoundaryCheck",
  "type": "object",
  "required": [
    "valid",
    "violations"
  ],
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "field",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
