{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreativeDirectorConfig",
  "type": "object",
  "properties": {
    "candidate_count": {
      "type": "integer",
      "minimum": 3,
      "maximum": 5,
      "default": 4
    },
    "default_fashion_commercial_balance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 45
    },
    "preservation_mode": {
      "enum": [
        "strict",
        "balanced"
      ],
      "default": "strict"
    },
    "allow_unverified_claims": {
      "const": false
    },
    "platform_intent": {
      "type": "string",
      "default": "social_commerce"
    }
  },
  "additionalProperties": false
}
